{
  "name": "ccg-craft",
  "version": "1.0.0",
  "description": "Collectible Card Game Crafting Tool",
  "private": true,
  "scripts": {
    "build": "webpack --mode=production",
    "dev": "webpack serve --mode=development",
    "start": "webpack serve --mode=development --open",
    "type-check": "tsc --noEmit",
    "check-face-duplicates": "node scripts/check-duplicate-face-lines.mjs"
  },
  "keywords": [
    "ccg",
    "card",
    "game"
  ],
  "author": {
    "name": "Félix Malboeuf"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/pdfkit": "^0.17.6",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.4",
    "eslint": "^10.8.1",
    "html-webpack-plugin": "^5.6.8",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2",
    "webpack-dev-server": "^6.0.0"
  },
  "dependencies": {
    "pdfkit": "^0.20.1"
  }
}
